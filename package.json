{
  "name": "mcp-khal",
  "version": "3.0.0",
  "description": "MCP server for reading and changing events in local .ics calendars (vdir)",
  "main": "dist/cli.js",
  "files": [
    "dist",
    "examples"
  ],
  "bin": {
    "mcp-khal": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run typecheck && vitest run --coverage",
    "start": "node dist/cli.js",
    "setup": "node dist/cli.js setup"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "calendar",
    "ics",
    "icalendar",
    "vdir",
    "vdirsyncer"
  ],
  "author": "Alexander Lehmann <afwlehmann@googlemail.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "effect": "^4.1.1",
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
